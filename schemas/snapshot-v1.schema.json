{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gaddhub:snapshot:v1",
  "title": "GaddHub snapshot v1 (provisional, client not verified)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "addon_version", "character", "captured_at", "sections"],
  "properties": {
    "schema_version": {"const": 1},
    "addon_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "captured_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "name", "realm", "class", "level"],
      "properties": {
        "character_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "realm": {"type": "string", "minLength": 1, "maxLength": 128},
        "class": {"type": "string", "minLength": 1, "maxLength": 64},
        "level": {"type": "integer", "minimum": 1, "maximum": 1000},
        "race": {"type": "string", "maxLength": 64},
        "faction": {"type": "string", "maxLength": 64}
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equipment", "talents", "professions", "inventory", "bank", "recipes"],
      "properties": {
        "equipment": {"$ref": "#/$defs/itemsSection"},
        "talents": {"$ref": "#/$defs/buildSection"},
        "professions": {"$ref": "#/$defs/itemsSection"},
        "inventory": {"$ref": "#/$defs/itemsSection"},
        "bank": {"$ref": "#/$defs/itemsSection"},
        "recipes": {"$ref": "#/$defs/itemsSection"}
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["available", "not_collected", "unavailable", "unsupported", "error"]
    },
    "itemsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "items": {
          "type": "array",
          "maxItems": 10000,
          "items": {"type": "object", "maxProperties": 64}
        },
        "reason": {"type": "string", "maxLength": 512}
      },
      "if": {"properties": {"status": {"const": "available"}}},
      "then": {"required": ["items"]},
      "else": {"not": {"required": ["items"]}}
    },
    "buildSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "build": {"type": "object", "maxProperties": 64},
        "reason": {"type": "string", "maxLength": 512}
      },
      "if": {"properties": {"status": {"const": "available"}}},
      "then": {"required": ["build"]},
      "else": {"not": {"required": ["build"]}}
    }
  }
}
